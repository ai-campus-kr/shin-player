<Window x:Class="ShinPlayer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ShinPlayer" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="신플레이어" Style="{StaticResource {x:Type Window}}" Width="1180" Height="760" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" AllowDrop="True" PreviewKeyDown="Window_KeyDown" Drop="Window_Drop" DragOver="Window_DragOver" Closing="Window_Closing" Icon="Assets/ShinPlayer.ico">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Bg}">
    <Grid x:Name="Root">
      <Grid.RowDefinitions><RowDefinition x:Name="TitleRow" Height="64" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="27" /></Grid.RowDefinitions>
      <Grid x:Name="TitleBar" Margin="22,0,10,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
          <Border Width="30" Height="30" Background="{DynamicResource Accent}" CornerRadius="9"><Path Data="M 0,0 L 0,15 L 10,7.5 Z M 13,0 L 13,15 L 16,15 L 16,0 Z" Fill="{DynamicResource AccentInk}" Width="16" Height="15" Stretch="Uniform" Margin="1,0,0,0" /></Border>
          <TextBlock Text="신플레이어" FontSize="16" FontWeight="SemiBold" Margin="11,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="TitleFile" Grid.Column="1" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,0,15,0" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="ChatButton" Content="AI" Click="Chat_Click" ToolTip="내장 자막으로 AI 구간 검색 · Ctrl+J" Padding="9,8" />
          <Button x:Name="DesignButton" Content="UI 선택" Click="Design_Click" ToolTip="미니멀 · 스튜디오 · 라이트 · 라임" Margin="0,0,4,0" />
          <Button Content="자막 캡처" Click="Capture_Click" Foreground="{DynamicResource Muted}" ToolTip="자막별 일괄 캡처 · Ctrl+Shift+S" Margin="0,0,4,0" />
          <Button x:Name="GifButton" Content="GIF" Click="Gif_Click" ToolTip="선택 구간을 움직이는 GIF로 저장" Padding="9,8" />
          <Button Click="Open_Click" Background="{DynamicResource Raised}" ToolTip="영상 열기 · Ctrl+O" Padding="13,8" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Path Data="M 1,4 L 6,4 L 9,7 L 18,7 L 18,17 L 1,17 Z" Stroke="{DynamicResource Ink}" StrokeThickness="1.4" Width="17" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="영상 열기" /></StackPanel></Button>
          <Button x:Name="MoreButton" Style="{StaticResource Glyph}" Content="&#xE712;" Click="More_Click" ToolTip="설정 및 메뉴" />
          <Border Width="1" Background="{DynamicResource Line}" Margin="10,9" />
          <Button Style="{StaticResource Glyph}" Content="&#xE921;" Click="Minimize_Click" ToolTip="최소화" />
          <Button x:Name="MaxButton" Style="{StaticResource Glyph}" Content="&#xE922;" Click="Maximize_Click" ToolTip="최대화 / 복원" />
          <Button Style="{StaticResource Glyph}" Content="&#xE8BB;" Click="Close_Click" ToolTip="닫고 트레이에서 대기" />
        </StackPanel>
      </Grid>
      <Border x:Name="AddressBar" Grid.Row="1" Margin="16,0,16,12" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="12,0,4,0">
        <Grid Height="38">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource Muted}" Margin="0,0,10,0" />
          <Grid Grid.Column="1">
            <TextBox x:Name="AddressInput" BorderThickness="0" Background="Transparent" Padding="0,8" VerticalContentAlignment="Center" FontSize="13" KeyDown="Address_KeyDown" GotKeyboardFocus="Address_GotKeyboardFocus" PreviewMouseLeftButtonDown="Address_MouseDown" ToolTip="유튜브 주소 입력 · Enter로 이동 · Alt+D / Ctrl+U" AutomationProperties.Name="유튜브 주소" />
            <TextBlock Text="유튜브 주소를 입력하세요" Foreground="{DynamicResource Muted}" FontSize="13" IsHitTestVisible="False">
              <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=AddressInput}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
          <Button x:Name="AddressGoButton" Grid.Column="2" Style="{StaticResource Glyph}" Content="&#xE72A;" Width="32" Height="30" Margin="6,0,0,0" Click="AddressGo_Click" ToolTip="이 주소로 이동 · Enter" AutomationProperties.Name="주소로 이동" />
        </Grid>
      </Border>
      <Grid x:Name="StageLayout" Grid.Row="2" Margin="16,0,16,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border x:Name="StageFrame" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource StageBrush}" CornerRadius="14">
          <Grid x:Name="Stage" ClipToBounds="True" Margin="1">
            <local:VideoHost x:Name="Video" Visibility="Hidden" Focusable="False" />
            <Grid x:Name="EmptyState">
              <Border x:Name="EmptyBackdrop" Background="{DynamicResource StageBrush}" CornerRadius="13" />
              <Border x:Name="LimeGlow" CornerRadius="13"><Border.Background><RadialGradientBrush GradientOrigin="0.87,0.75" Center="0.85,0.65" RadiusX="0.7" RadiusY="0.9"><GradientStop Color="#202B18" Offset="0" /><GradientStop Color="#10150F" Offset="0.6" /><GradientStop Color="#0E120D" Offset="1" /></RadialGradientBrush></Border.Background></Border>
              <Grid x:Name="EmptyArtwork" Width="290" Height="250" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,54,0" IsHitTestVisible="False">
                <Border Width="232" Height="164" BorderBrush="#39492B" BorderThickness="1" CornerRadius="20" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="-18" /></Border.RenderTransform></Border>
                <Border Width="232" Height="164" BorderBrush="#53663A" BorderThickness="1" CornerRadius="20" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="-7" /></Border.RenderTransform></Border>
                <Border Width="232" Height="164" BorderThickness="1" CornerRadius="20" Background="#1E2819"><Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#A5C274" /><GradientStop Color="#34402C" Offset="0.8" /></LinearGradientBrush></Border.BorderBrush><Path Data="M 0,0 L 0,62 L 49,31 Z" Fill="{DynamicResource Accent}" Width="43" Height="54" Stretch="Uniform" Margin="7,0,0,0" /></Border>
                <TextBlock Text="SHIN / PLAYER" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontFamily="Bahnschrift" FontSize="11" Foreground="#9BAD85" Margin="0,0,0,0" />
              </Grid>
              <StackPanel x:Name="EmptyCopy" Margin="46,22,34,22" HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="500">
                <TextBlock x:Name="DesignEyebrow" Text="PLAY AT YOUR PACE" FontFamily="Bahnschrift" FontSize="11" Foreground="{DynamicResource Accent}" Margin="0,0,0,17" />
                <TextBlock x:Name="EmptyTitle" Text="당신의 영상,&#x0a;원하는 속도로." FontSize="43" LineHeight="54" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="EmptyDescription" Text="영상 파일을 이곳에 놓아주세요." Foreground="{DynamicResource Muted}" FontSize="13" Margin="1,13,0,23" TextWrapping="Wrap" />
                <StackPanel x:Name="EmptyActions" Orientation="Horizontal"><Button Content="영상 열기  ↗" Style="{StaticResource Primary}" Click="Open_Click" /><Button x:Name="RecentButton" Content="최근 영상" Foreground="{DynamicResource Muted}" Margin="10,0,0,0" Click="Recent_Click" /></StackPanel>
              </StackPanel>
              <TextBlock Text="MP4  /  MKV  /  MOV  /  WEBM" FontFamily="Bahnschrift" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,18" />
            </Grid>
          </Grid>
        </Border>
        <Border x:Name="PlaylistPanel" Grid.Column="1" Width="260" Margin="12,0,0,0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Visibility="Collapsed">
          <Grid Margin="12,12,12,12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Margin="4,0,0,10"><Button DockPanel.Dock="Right" Style="{StaticResource Glyph}" Content="&#xE8BB;" Width="30" Click="Playlist_Click" ToolTip="재생목록 닫기" /><TextBlock x:Name="QueueCount" Text="재생목록 · 0" FontWeight="SemiBold" /></DockPanel>
            <ListBox x:Name="QueueList" Grid.Row="1" MouseDoubleClick="Queue_DoubleClick" KeyDown="Queue_KeyDown" SelectionMode="Single">
              <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="33" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,3,0,0" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" ToolTip="{Binding Path}" /><TextBlock Text="{Binding Extension}" Foreground="{DynamicResource Muted}" FontFamily="Bahnschrift" FontSize="10" Margin="0,6,0,0" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Content="+ 파일 추가" Click="Add_Click" Background="{DynamicResource Raised}" Margin="0,0,4,0" /><Button Grid.Column="1" Content="선택 제거" Click="Remove_Click" Foreground="{DynamicResource Muted}" Margin="4,0,0,0" /></Grid>
          </Grid>
        </Border>
      </Grid>
      <Border x:Name="ControlPanel" Grid.Row="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Margin="16,0,16,0" Padding="20,10,20,9">
        <Grid x:Name="ControlsGrid"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid x:Name="SeekDeck"><Grid.RowDefinitions><RowDefinition x:Name="TimeRow" Height="18" /><RowDefinition Height="28" /></Grid.RowDefinitions>
          <Grid><StackPanel Orientation="Horizontal"><TextBlock x:Name="PositionText" Text="00:00" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Accent}" /><TextBlock Text=" / " FontFamily="Consolas" Foreground="{DynamicResource Muted}" Margin="4,0" /><TextBlock x:Name="DurationText" Text="00:00" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource Muted}" /></StackPanel><TextBlock x:Name="SeekHint" Text="클릭해서 이동 · 드래그로 탐색" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" /></Grid>
          <Slider x:Name="SeekBar" Grid.Row="1" Maximum="1" IsEnabled="False" ValueChanged="Seek_Changed" ToolTip="클릭한 위치로 이동" AutomationProperties.Name="재생 위치" />
          </Grid>
          <Grid x:Name="TransportDeck" Grid.Row="1" Height="54"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="VolumeDock" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="MuteButton" Style="{StaticResource Glyph}" Content="&#xE767;" Click="Mute_Click" ToolTip="음소거 · M" /><Slider x:Name="VolumeBar" Width="76" Minimum="0" Maximum="100" Value="70" ValueChanged="Volume_Changed" Margin="5,0,8,0" ToolTip="음량 · ↑ ↓" AutomationProperties.Name="음량" /><TextBlock x:Name="VolumeText" Text="70" Width="25" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Muted}" /><Button x:Name="BoostButton" Content="증폭" Click="Boost_Click" Width="62" FontSize="11" Padding="4,5" Margin="5,0,0,0" AutomationProperties.Name="음량 증폭" /></StackPanel>
            <StackPanel x:Name="TransportButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource Glyph}" Content="&#xE892;" Click="Previous_Click" ToolTip="이전 영상 · Shift+N" /><Button Content="−5" FontFamily="Bahnschrift" FontSize="14" Click="Backward_Click" Padding="9,5" ToolTip="5초 뒤로 · ←" /><Button x:Name="PlayButton" Style="{StaticResource Play}" Content="&#xE768;" Click="Play_Click" Margin="10,0" ToolTip="재생 / 일시정지 · Space" /><Button Content="+5" FontFamily="Bahnschrift" FontSize="14" Click="Forward_Click" Padding="9,5" ToolTip="5초 앞으로 · →" /><Button Style="{StaticResource Glyph}" Content="&#xE893;" Click="Next_Click" ToolTip="다음 영상 · N" /></StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="AbButton" Content="A–B" Click="Ab_Click" FontFamily="Bahnschrift" FontSize="12" Padding="10,5" ToolTip="구간 반복 · A" /><Button Style="{StaticResource Glyph}" Content="CC" FontFamily="Bahnschrift" FontSize="13" Click="Subtitle_Click" ToolTip="자막 / 오디오" /><Button Style="{StaticResource Glyph}" Click="Playlist_Click" ToolTip="재생목록 · Ctrl+L"><Path Data="M 1,2 L 3,2 M 7,2 L 19,2 M 1,8 L 3,8 M 7,8 L 19,8 M 1,14 L 3,14 M 7,14 L 19,14" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Width="18" Height="14" Stretch="Uniform" /></Button><Button Style="{StaticResource Glyph}" Content="&#xE740;" Click="Fullscreen_Click" ToolTip="전체화면 · F / F11" /></StackPanel>
          </Grid>
          <Grid x:Name="SpeedDeck" Grid.Row="2" Height="42" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="배속" Foreground="{DynamicResource Muted}" FontSize="11" Margin="5,0,12,0" /><Button x:Name="SpeedValue" Content="1.00×" FontFamily="Bahnschrift" FontSize="23" Padding="2,0,10,0" Click="CustomSpeed_Click" ToolTip="배속 직접 입력 · 0.25~8배" /></StackPanel>
            <UniformGrid x:Name="SpeedPresets" Grid.Column="1" Rows="1" Margin="22,0" VerticalAlignment="Center" MaxWidth="440"><Button Content="0.75×" Tag="0.75" Click="Speed_Click" Padding="8,5" /><Button Content="1×" Tag="1" Click="Speed_Click" Padding="8,5" /><Button Content="1.25×" Tag="1.25" Click="Speed_Click" Padding="8,5" /><Button Content="1.5×" Tag="1.5" Click="Speed_Click" Padding="8,5" /><Button Content="2×" Tag="2" Click="Speed_Click" Padding="8,5" /><Button Content="3×" Tag="3" Click="Speed_Click" Padding="8,5" /></UniformGrid>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="−" Width="30" Padding="0" Click="Slower_Click" ToolTip="0.05배 느리게 · Shift+[" /><TextBlock Text="0.05" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Muted}" Margin="4,0" /><Button Content="+" Width="30" Padding="0" Click="Faster_Click" ToolTip="0.05배 빠르게 · Shift+]" /></StackPanel>
          </Grid>
        </Grid>
      </Border>
      <Grid Grid.Row="4" Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="준비됨 · Ctrl+O로 영상 열기" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="EngineText" Grid.Column="1" Text="음높이 유지" FontSize="10" Foreground="{DynamicResource Muted}" Margin="16,0,0,0" /></Grid>
    </Grid>
  </Border>
</Window>

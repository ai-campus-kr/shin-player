<Window x:Class="ShinPlayer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ShinPlayer" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="신플레이어" Style="{StaticResource {x:Type Window}}" Width="1180" Height="760" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" AllowDrop="True" PreviewKeyDown="Window_KeyDown" Drop="Window_Drop" DragOver="Window_DragOver" Closing="Window_Closing" Icon="Assets/ShinPlayer.ico">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#30394A" BorderThickness="1">
    <Grid x:Name="Root">
      <Grid.RowDefinitions><RowDefinition x:Name="TitleRow" Height="52" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="28" /></Grid.RowDefinitions>
      <Grid x:Name="TitleBar" Background="#171D27">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="20,0,24,0"><Path Data="M 0,0 L 0,20 L 16,10 Z M 19,1 L 19,19 L 23,19 L 23,1 Z" Fill="{StaticResource Accent}" Width="24" Height="20" Stretch="Uniform" /><TextBlock Text="신플레이어" FontSize="16" FontWeight="Bold" Margin="12,0,0,0" /></StackPanel>
        <TextBlock x:Name="TitleFile" Grid.Column="1" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" FontSize="12" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="영상 열기" Click="Open_Click" Padding="14,5" Margin="0,8,5,8" ToolTip="영상 열기 · Ctrl+O" />
          <Button x:Name="MoreButton" Style="{StaticResource Glyph}" Content="&#xE712;" Click="More_Click" ToolTip="설정 및 메뉴" />
          <Border Width="1" Background="{StaticResource Line}" Margin="8,15" />
          <Button Style="{StaticResource Glyph}" Content="&#xE921;" Click="Minimize_Click" ToolTip="최소화" />
          <Button x:Name="MaxButton" Style="{StaticResource Glyph}" Content="&#xE922;" Click="Maximize_Click" ToolTip="최대화 / 복원" />
          <Button Style="{StaticResource Glyph}" Content="&#xE8BB;" Click="Close_Click" ToolTip="닫고 트레이에서 대기" Margin="0,0,6,0" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Grid x:Name="Stage" Background="#090D13" ClipToBounds="True">
          <local:VideoHost x:Name="Video" Visibility="Hidden" Focusable="False" />
          <Grid x:Name="EmptyState" Margin="40,20">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" MaxWidth="550">
              <Grid Width="78" Height="78" HorizontalAlignment="Center" Margin="0,0,0,23">
                <Rectangle RadiusX="22" RadiusY="22" Fill="#192B43" /><Path Data="M 0,0 L 0,30 L 23,15 Z M 28,0 L 28,30 L 33,30 L 33,0 Z" Stretch="Uniform" Fill="{StaticResource Accent}" Width="35" Height="31" Margin="5,0,0,0" />
              </Grid>
              <TextBlock x:Name="EmptyTitle" Text="영상 파일을 열어주세요" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock x:Name="EmptyDescription" Text="여기에 파일을 놓거나, 아래 버튼으로 선택하세요." Foreground="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,25" TextWrapping="Wrap" TextAlignment="Center" />
              <Button Content="영상 열기  ↗" Style="{StaticResource Primary}" Click="Open_Click" HorizontalAlignment="Center" Width="156" />
              <TextBlock Text="MP4 · MKV · AVI · MOV · WEBM 외 다양한 형식" FontSize="11" Foreground="#72819A" HorizontalAlignment="Center" Margin="0,18,0,0" />
              <Button x:Name="RecentButton" Content="최근 영상 다시 열기" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,20,0,0" Click="Recent_Click" />
            </StackPanel>
            <TextBlock Grid.Row="2" Text="SPACE  재생 / 일시정지          [  ]  배속 조절          F  전체화면" Foreground="#66748B" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,20,0,5" />
          </Grid>
        </Grid>
        <Border x:Name="PlaylistPanel" Grid.Column="1" Width="272" Background="#161D28" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Visibility="Collapsed">
          <Grid Margin="14,14,14,12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Margin="4,0,0,12"><TextBlock x:Name="QueueCount" Text="재생목록 · 0" FontWeight="SemiBold" /><Button Style="{StaticResource Glyph}" Content="&#xE8BB;" Width="28" Height="30" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Playlist_Click" ToolTip="재생목록 닫기" /></DockPanel>
            <ListBox x:Name="QueueList" Grid.Row="1" MouseDoubleClick="Queue_DoubleClick" KeyDown="Queue_KeyDown" SelectionMode="Single">
              <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" ToolTip="{Binding Path}" /><TextBlock Text="{Binding Extension}" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="10" Margin="0,5,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Button Content="+ 파일 추가" Click="Add_Click" BorderThickness="1" Margin="0,0,4,0" /><Button Grid.Column="1" Content="선택 제거" Click="Remove_Click" BorderThickness="1" Margin="4,0,0,0" /></Grid>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="2" Background="#171F2B" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,10,22,10">
        <Grid><Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="52" /><RowDefinition Height="1" /><RowDefinition Height="61" /></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65" /><ColumnDefinition Width="*" /><ColumnDefinition Width="65" /></Grid.ColumnDefinitions><TextBlock x:Name="PositionText" Text="00:00" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Accent}" /><Slider x:Name="SeekBar" Grid.Column="1" Maximum="1" IsEnabled="False" ValueChanged="Seek_Changed" ToolTip="원하는 위치로 이동" /><TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource Muted}" FontSize="12" /></Grid>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"><Button x:Name="MuteButton" Style="{StaticResource Glyph}" Content="&#xE767;" Click="Mute_Click" ToolTip="음소거 · M" /><Slider x:Name="VolumeBar" Width="84" Minimum="0" Maximum="100" Value="70" ValueChanged="Volume_Changed" Margin="5,0,7,0" ToolTip="음량 · ↑ ↓" /><TextBlock x:Name="VolumeText" Text="70" Width="27" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource Glyph}" Content="&#xE892;" Click="Previous_Click" ToolTip="이전 영상 · Shift+N" /><Button Content="−5초" Click="Backward_Click" Padding="8,5" ToolTip="5초 뒤로 · ←" /><Button x:Name="PlayButton" Style="{StaticResource Glyph}" Content="&#xE768;" Click="Play_Click" Background="{StaticResource Accent}" Foreground="#0C1C32" Width="48" Height="42" Margin="10,0" ToolTip="재생 / 일시정지 · Space" /><Button Content="+5초" Click="Forward_Click" Padding="8,5" ToolTip="5초 앞으로 · →" /><Button Style="{StaticResource Glyph}" Content="&#xE893;" Click="Next_Click" ToolTip="다음 영상 · N" /></StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="AbButton" Content="A–B" Click="Ab_Click" FontFamily="Consolas" FontSize="12" ToolTip="구간 반복: 시작 → 끝 → 해제 · A" /><Button Style="{StaticResource Glyph}" Content="&#xE8F2;" Click="Subtitle_Click" ToolTip="자막 / 오디오" /><Button Style="{StaticResource Glyph}" Content="&#xE8F1;" Click="Playlist_Click" ToolTip="재생목록 · Ctrl+L" /><Button Style="{StaticResource Glyph}" Content="&#xE740;" Click="Fullscreen_Click" ToolTip="전체화면 · F / F11" /></StackPanel>
          </Grid>
          <Border Grid.Row="2" Background="#2C3747" Margin="0,4,0,0" />
          <Grid Grid.Row="3" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="재생 속도" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,12,0" /><Button x:Name="SpeedValue" Content="1.00×" FontFamily="Bahnschrift, Segoe UI" FontSize="25" FontWeight="SemiBold" Padding="2,0,8,0" Click="CustomSpeed_Click" ToolTip="배속 직접 입력 · 0.25~8배" /></StackPanel>
            <UniformGrid x:Name="SpeedPresets" Grid.Column="1" Rows="1" Margin="18,0" VerticalAlignment="Center" MaxWidth="535"><Button Content="0.75×" Tag="0.75" Click="Speed_Click" /><Button Content="1×" Tag="1" Click="Speed_Click" /><Button Content="1.25×" Tag="1.25" Click="Speed_Click" /><Button Content="1.5×" Tag="1.5" Click="Speed_Click" /><Button Content="2×" Tag="2" Click="Speed_Click" /><Button Content="3×" Tag="3" Click="Speed_Click" /></UniformGrid>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="−" Width="32" Padding="0" Click="Slower_Click" ToolTip="0.05배 느리게 · Shift+[" /><TextBlock Text="0.05" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}" Margin="4,0" /><Button Content="+" Width="32" Padding="0" Click="Faster_Click" ToolTip="0.05배 빠르게 · Shift+]" /></StackPanel>
          </Grid>
        </Grid>
      </Border>
      <Grid Grid.Row="3" Background="#121923" Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="준비됨 · 영상 파일을 더블클릭해 바로 재생" FontSize="10" Foreground="{StaticResource Muted}" Margin="22,0" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="EngineText" Grid.Column="1" Text="음높이 유지  ·  GPU 자동" FontSize="10" Foreground="#7C90AD" Margin="10,0,22,0" /></Grid>
    </Grid>
  </Border>
</Window>
